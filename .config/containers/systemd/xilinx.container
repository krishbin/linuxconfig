[Unit]
Description=Xilinx Container for running Xilinx applications

[Container]
Annotation=run.oci.keep_original_groups=1
AutoUpdate=registry
ContainerName=xilinx
Environment=SHELL=bash
Environment=HOME=%h
Environment="_JAVA_OPTIONS=-Dawt.useSystemAAFontSettings=lcd -Dswing.defaultlaf=com.sun.java.swing.plaf.gtk.GTKLookAndFeel" "_JAVA_AWT_WM_NONREPARENTING=1"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/host/run/dbus/system_bus_socket"
Environment=container=podman
Exec=--verbose --name %u --user %U --group %G --home %h --init "0" --nvidia "1" -- " "
Image=ghcr.io/krishbin/xilinx-container:latest
HostName=xilinx.%l
Label=manager=distrobox
Network=host
PodmanArgs=--entrypoint /usr/bin/entrypoint
PodmanArgs=--ipc host
PodmanArgs=--pid host
PodmanArgs=--privileged
PodmanArgs=--security-opt label=disable
PodmanArgs=--security-opt apparmor=unconfined
Ulimit=host
User=root:root
UserNS=keep-id
Volume=/:/run/host:rslave
Volume=/tmp:/tmp:rslave
Volume=/usr/bin/distrobox-init:/usr/bin/entrypoint:ro
Volume=/usr/bin/distrobox-export:/usr/bin/distrobox-export:ro
Volume=/usr/bin/distrobox-host-exec:/usr/bin/distrobox-host-exec:ro
Volume=%h:%h:rslave
Volume=/dev:/dev:rslave
Volume=/sys:/sys:rslave
Volume=/dev/pts
Volume=/dev/null:/dev/ptmx
Volume=/var/log/journal
Volume=/home/%u:/home/%u:rslave
Volume=%t:%t:rslave
Volume=/etc/hosts:/etc/hosts:ro
Volume=/etc/resolv.conf:/etc/resolv.conf:ro


[Service]


[Install]
WantedBy=xilinx.target
